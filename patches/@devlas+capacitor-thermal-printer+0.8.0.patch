+    /**
+     * Varias térmicas económicas publican un SDP incompleto o sólo el servicio
+     * PnP aunque internamente escuchen ESC/POS por RFCOMM. Android permite
+     * intentar primero SPP inseguro (el enlace ya fue emparejado), luego SPP
+     * seguro y, como último recurso, el canal RFCOMM 1 usado por estos módulos.
+     */
+    @SuppressLint("MissingPermission", "DiscouragedPrivateApi")
+    private fun connectCompatible(device: BluetoothDevice): BluetoothSocket {
+        val factories: List<() -> BluetoothSocket> = listOf(
+            { device.createInsecureRfcommSocketToServiceRecord(SPP_UUID) },
+            { device.createRfcommSocketToServiceRecord(SPP_UUID) },
+            {
+                val method = device.javaClass.getMethod(
+                    "createRfcommSocket",
+                    Int::class.javaPrimitiveType,
+                )
+                method.invoke(device, 1) as BluetoothSocket
+            },
+        )
+        var lastError: Throwable? = null
+        for (factory in factories) {
+            val socket = try {
+                factory()
+            } catch (error: Throwable) {
+                lastError = error
+                continue
+            }
+            try {
+                socket.connect()
+                return socket
+            } catch (error: Throwable) {
+                lastError = error
+                runCatching { socket.close() }
+            }
+        }
+        throw IOException("No fue posible abrir SPP/RFCOMM compatible", lastError)
+    }
