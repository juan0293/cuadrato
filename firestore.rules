rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return !isAuthenticated()
        ? null
        : (
            exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
              ? (
                  get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol != null
                    ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
                    : get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role
                )
              : (
                  exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    ? (
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol != null
                          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol
                          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                      )
                    : null
                )
          );
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'superadmin';
    }

    function isAsistente() {
      return role() == 'asistente' || role() == 'assistant';
    }

    function isArtista() {
      return role() == 'artista' || role() == 'artist';
    }

    function isOperativo() {
      return isAdmin() || isAsistente() || isArtista();
    }

    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (isOperativo() || request.auth.uid == userId);
      allow create: if isAuthenticated() && isOperativo();
      allow update: if isAuthenticated() && (isOperativo() || request.auth.uid == userId);
      allow delete: if false;
    }

    match /citas/{citaId} {
      allow read: if isAuthenticated() && (isOperativo() || resource.data.artistaId == request.auth.uid);
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /disponibilidadArtistas/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOperativo();
    }

    match /insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /movimientosInventario/{movId} {
      allow read: if isAuthenticated() && (isOperativo() || resource.data.artistaId == request.auth.uid);
      allow create: if isAuthenticated() && (isOperativo() || isArtista());
      allow update, delete: if false;
    }

    match /movimientosFinancieros/{movId} {
      allow read: if isAuthenticated() && (isOperativo() || resource.data.artistaId == request.auth.uid);
      allow create: if isAuthenticated() && isOperativo();
      allow update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /facturas/{facturaId} {
      allow read: if isAuthenticated() && (isOperativo() || resource.data.artistaId == request.auth.uid);
      allow create: if isAuthenticated() && isOperativo()
        && request.resource.data.get('tipoDocumento', '') != 'precuenta'
        && (!request.resource.data.keys().hasAny(['cuentaAbiertaId']) || (
          (isAdmin() || isAsistente())
          && get(/databases/$(database)/documents/cuentasAbiertas/$(request.resource.data.cuentaAbiertaId)).data.estado == 'abierta'
          && get(/databases/$(database)/documents/cuentasAbiertas/$(request.resource.data.cuentaAbiertaId)).data.version == request.resource.data.cuentaAbiertaVersion
          && getAfter(/databases/$(database)/documents/cuentasAbiertas/$(request.resource.data.cuentaAbiertaId)).data.facturaId == facturaId
          && getAfter(/databases/$(database)/documents/cuentasAbiertas/$(request.resource.data.cuentaAbiertaId)).data.estado == 'cerrada'
        ));
      allow update: if isAuthenticated() && isOperativo()
        && request.resource.data.get('cuentaAbiertaId', '') == resource.data.get('cuentaAbiertaId', '')
        && request.resource.data.get('cuentaAbiertaVersion', 0) == resource.data.get('cuentaAbiertaVersion', 0);
      allow delete: if false;
    }

    match /turnosCaja/{turnoId} {
      allow read: if isAuthenticated() && (isOperativo() || resource.data.usuarioId == request.auth.uid);
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /facturacionSecuencias/{id} {
      allow read, create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /clientes/{clienteId} {
      allow read: if isAuthenticated() && isOperativo();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    // Inventario fiscal-ready
    match /productosServicios/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /compras/{id} {
      allow read: if isAuthenticated() && isOperativo();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /cuentasPorPagar/{id} {
      allow read: if isAuthenticated() && isOperativo();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;

      match /pagos/{pagoId} {
        allow read, create: if isAuthenticated() && isOperativo();
        allow update, delete: if false;
      }
    }

    // Cuentas de consumo: mismos perfiles habilitados en el punto de venta.
    // Sin borrado físico ni reapertura; revisiones y cierre fiscal atómicos.
    match /cuentasAbiertas/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isAsistente());
      allow create: if isAuthenticated() && (isAdmin() || isAsistente())
        && request.resource.data.estado == 'abierta'
        && request.resource.data.version == 1
        && request.resource.data.id == id
        && request.resource.data.creadaPor == request.auth.uid
        && request.resource.data.actualizadaPor == request.auth.uid
        && request.resource.data.clienteNombre is string
        && request.resource.data.clienteNombre.size() > 0
        && request.resource.data.clienteNombre.size() <= 120
        && request.resource.data.items is list
        && !request.resource.data.keys().hasAny(['facturaId', 'cerradaEn']);
      allow update: if isAuthenticated() && (isAdmin() || isAsistente())
        && resource.data.estado == 'abierta'
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.actualizadaPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clienteNombre', 'clienteId', 'items', 'descuentoGlobal', 'subtotal', 'impuesto', 'total',
          'version', 'actualizadaPor', 'actualizadaEn', 'estado', 'facturaId', 'cerradaEn', 'motivoCancelacion'
        ])
        && (
          (request.resource.data.estado == 'abierta'
            && !request.resource.data.keys().hasAny(['facturaId', 'cerradaEn', 'motivoCancelacion']))
          || (request.resource.data.estado == 'cancelada'
            && request.resource.data.motivoCancelacion is string
            && request.resource.data.motivoCancelacion.size() > 0
            && !request.resource.data.keys().hasAny(['facturaId', 'cerradaEn']))
          || (request.resource.data.estado == 'cerrada'
            && getAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.cuentaAbiertaId == id
            && getAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.cuentaAbiertaVersion == resource.data.version
            && getAfter(/databases/$(database)/documents/facturas/$(request.resource.data.facturaId)).data.estado == 'emitida')
        );
      allow delete: if false;
      match /eventos/{eventoId} {
        allow read: if isAuthenticated() && (isAdmin() || isAsistente());
        allow create: if isAuthenticated() && (isAdmin() || isAsistente())
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.version == getAfter(/databases/$(database)/documents/cuentasAbiertas/$(id)).data.version;
        allow update, delete: if false;
      }
    }

    match /cuentasPorCobrar/{id} {
      allow read: if isAuthenticated() && isOperativo();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;

      match /cobros/{cobroId} {
        allow read, create: if isAuthenticated() && isOperativo();
        allow update, delete: if false;
      }
    }

    match /categoriasProductos/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /unidadesMedida/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /utilidades/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /proveedores/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /configuracionEmpresa/{id} {
      allow read: if isAuthenticated() && isOperativo();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }

    match /categoriasFinancieras/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOperativo();
      allow delete: if false;
    }
  }
}
